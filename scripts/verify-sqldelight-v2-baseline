#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Retain this entry point for existing callers. The squashed-baseline phase has
# ended: validate immutable history and execute the actual numbered migration.
# The Gradle verifySqlDelightMigration gate additionally runs the nonempty JVM
# upgrade test through the same shared driver used by Desktop.
python3 - "$ROOT_DIR" <<'PY'
import hashlib
import pathlib
import re
import sqlite3
import sys
import tempfile

root = pathlib.Path(sys.argv[1]) / 'shared/data/src/commonMain/sqldelight'
snapshots = root / 'databases'
sources = root / 'saien/someday/data/local/db'
assert sorted(p.name for p in snapshots.glob('*.db')) == ['1.db', '2.db', '3.db'], 'Unexpected snapshot history'
assert sorted(p.name for p in sources.glob('*.sqm')) == ['1.sqm', '2.sqm'], 'Unexpected migration history'
assert hashlib.sha256((snapshots / '1.db').read_bytes()).hexdigest() == 'dc072bc31201875d4f186398757c8e5c67dbb7c17b99edd2af12bf88a8e8fd59', 'Frozen schema 1 changed'
assert hashlib.sha256((snapshots / '2.db').read_bytes()).hexdigest() == '24c701ce5fc555a86e29ae99970d62c0718aff48d88a261e1aadc4ff097117ef', 'Frozen schema 2 changed'
assert hashlib.sha256((sources / '1.sqm').read_bytes()).hexdigest() == '2b3c3ff66d6b915c704ffdce4dd8c53b80e3e0f03f2221eb7f9af17c3eda1725', 'Frozen migration 1 changed'

# Tokenize rather than deleting whitespace inside CHECK string literals.
def normalized(sql):
    return [token if token.startswith("'") else token.lower().strip('"') for token in
            re.findall(r"'(?:''|[^'])*'|\"(?:\"\"|[^\"])*\"|[A-Za-z_][A-Za-z_0-9]*|[0-9]+|\S", sql or '')]

def catalog(db):
    assert db.execute('PRAGMA integrity_check').fetchall() == [('ok',)]
    assert db.execute('PRAGMA foreign_key_check').fetchall() == []
    return [(kind, name, table, normalized(sql)) for kind, name, table, sql in db.execute(
        "SELECT type,name,tbl_name,sql FROM sqlite_master WHERE name NOT LIKE 'sqlite_%' ORDER BY type,name")]

with tempfile.TemporaryDirectory(prefix='someday-migration-') as directory:
    upgraded_path = pathlib.Path(directory) / 'upgraded.db'
    upgraded_path.write_bytes((snapshots / '1.db').read_bytes())
    with sqlite3.connect(upgraded_path) as upgraded, sqlite3.connect(':memory:') as fresh, sqlite3.connect(
            f'file:{snapshots / "3.db"}?mode=ro', uri=True) as snapshot:
        upgraded.execute('PRAGMA foreign_keys=ON')
        upgraded.executescript((sources / '1.sqm').read_text())
        with sqlite3.connect(f'file:{snapshots / "2.db"}?mode=ro', uri=True) as schema_two:
            assert catalog(upgraded) == catalog(schema_two), 'Migration 1 differs from frozen schema 2'
        upgraded.executescript((sources / '2.sqm').read_text())
        schema = re.split(r'^\w+:\s*$', (sources / 'Someday.sq').read_text(), maxsplit=1, flags=re.MULTILINE)[0]
        fresh.executescript(schema)
        assert catalog(upgraded) == catalog(fresh), 'Migrated catalog differs from fresh schema'
        assert catalog(snapshot) == catalog(fresh), 'Schema 3 snapshot differs from fresh schema'
print('SQLDelight v1→v2→v3 migration and frozen snapshots verified; Gradle also runs the nonempty shared-driver upgrade test.')
PY
