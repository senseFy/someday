#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
GRADLEW="${GRADLEW:-$ROOT_DIR/gradlew}"
POSTGRES_IMAGE="postgres@sha256:16bc17c64a573ef34162af9298258d1aec548232985b33ed7b1eac33ba35c229"
WEBDAV_IMAGE="bytemark/webdav@sha256:bcabbc024c511b9c63ed3345f88573e31d84c952ee493c9acb3fe345f4f80f57"
GATE_PROPERTY="-Psomeday.syncV2ReliabilityGate=true"

mkdir -p "$ROOT_DIR/build"
RUN_DIR="$(mktemp -d "$ROOT_DIR/build/sync-v2-reliability-gate.XXXXXX")"
FINAL_DIR="$ROOT_DIR/build/sync-v2-reliability-gate"
mkdir -p "$FINAL_DIR"
SERVER_LOG="$RUN_DIR/server.log"
ARCHITECTURE_LOG="$RUN_DIR/architecture.log"
PHASES="$RUN_DIR/phases.tsv"
REPORT="$RUN_DIR/report.json"
EVIDENCE_MANIFEST="$ROOT_DIR/scripts/sync-v2-test-evidence.tsv"
RUN_SUFFIX="$(date +%s)-$$"
POSTGRES_NAME="someday-v2-gate-postgres-$RUN_SUFFIX"
WEBDAV_NAME="someday-v2-gate-webdav-$RUN_SUFFIX"
WEBDAV_USERNAME="v2-gate-user-$RUN_SUFFIX"
WEBDAV_PASSWORD="v2-gate-secret-$RUN_SUFFIX"
SERVER_PID=""
GATE_STARTED_AT="$(date +%s)"

die() {
    printf 'sync-v2 gate error: %s\n' "$*" >&2
    exit 1
}

info() {
    printf '[sync-v2 gate] %s\n' "$*" >&2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

require_java_21() {
    local java_bin
    local feature_version
    if [[ -n "${JAVA_HOME:-}" ]]; then
        java_bin="$JAVA_HOME/bin/java"
    else
        java_bin="$(command -v java)"
    fi
    [[ -x "$java_bin" ]] || die "JAVA_HOME does not provide an executable java runtime"
    feature_version="$(
        "$java_bin" -XshowSettings:properties -version 2>&1 |
            sed -n 's/^[[:space:]]*java\.specification\.version = \([0-9][0-9]*\).*$/\1/p' |
            head -1
    )"
    [[ "$feature_version" =~ ^[0-9]+$ ]] ||
        die "could not determine the configured Java feature version"
    ((feature_version >= 21)) ||
        die "JDK 21 or newer is required; set JAVA_HOME before running the Sync V2 gate"
}

ensure_pinned_image() {
    local image="$1"
    if docker image inspect "$image" >/dev/null 2>&1; then
        info "using cached pinned image: $image"
    else
        docker pull "$image" >/dev/null
    fi
}

cleanup() {
    local status=$?
    if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" >/dev/null 2>&1; then
        kill "$SERVER_PID" >/dev/null 2>&1 || true
        wait "$SERVER_PID" >/dev/null 2>&1 || true
    fi
    docker rm -f "$WEBDAV_NAME" "$POSTGRES_NAME" >/dev/null 2>&1 || true
    if [[ -f "$REPORT" ]]; then
        cp "$REPORT" "$FINAL_DIR/report.json"
    fi
    if [[ -f "$SERVER_LOG" ]]; then
        tail -n 300 "$SERVER_LOG" > "$FINAL_DIR/server-tail.log" || true
    fi
    exit "$status"
}
trap cleanup EXIT INT TERM

phase() {
    local name="$1"
    shift
    local started finished
    started="$(date +%s)"
    info "$name"
    "$@"
    finished="$(date +%s)"
    printf '%s\t%s\n' "$name" "$((finished - started))" >> "$PHASES"
}

container_port() {
    local name="$1"
    local port="$2"
    docker port "$name" "$port/tcp" |
        sed -n '1s/.*://p' |
        tr -d '[:space:]'
}

wait_for() {
    local label="$1"
    shift
    local attempt
    for attempt in $(seq 1 60); do
        if "$@" >/dev/null 2>&1; then
            return 0
        fi
        if [[ -n "$SERVER_PID" ]] && ! kill -0 "$SERVER_PID" >/dev/null 2>&1; then
            tail -n 120 "$SERVER_LOG" >&2 || true
            die "$label exited before becoming healthy"
        fi
        sleep 1
    done
    die "$label did not become healthy within 60 seconds"
}

start_installed_server() {
    local server_executable="$ROOT_DIR/server/build/install/server/bin/server"
    [[ -x "$server_executable" ]] || die "installed server executable not found: $server_executable"

    : > "$SERVER_LOG"
    SOMEDAY_PORT="$SERVER_PORT" \
    SOMEDAY_DB_URL="$DB_URL" \
    SOMEDAY_DB_USER=someday \
    SOMEDAY_DB_PASSWORD=gate-only-password \
        "$server_executable" >"$SERVER_LOG" 2>&1 &
    SERVER_PID=$!
    wait_for "Ktor server" curl -fsS "$SERVER_ENDPOINT/health"
}

run_architecture_scan() {
    "$ROOT_DIR/scripts/verify-sync-v2-architecture" 2>&1 | tee "$ARCHITECTURE_LOG"
}

validate_and_report() {
    local finished_at="$1"
    python3 - \
        "$ROOT_DIR" \
        "$PHASES" \
        "$REPORT" \
        "$EVIDENCE_MANIFEST" \
        "$ARCHITECTURE_LOG" \
        "$GATE_STARTED_AT" \
        "$finished_at" <<'PY'
import json
import pathlib
import subprocess
import sys
import xml.etree.ElementTree as ET

root = pathlib.Path(sys.argv[1])
phase_path = pathlib.Path(sys.argv[2])
report_path = pathlib.Path(sys.argv[3])
manifest_path = pathlib.Path(sys.argv[4])
architecture_path = pathlib.Path(sys.argv[5])
started = int(sys.argv[6])
finished = int(sys.argv[7])

target_roots = {
    "data-jvm": root / "shared/data/build/test-results/jvmTest",
    "domain-jvm": root / "shared/domain/build/test-results/jvmTest",
    "sync-jvm": root / "shared/sync/build/test-results/jvmTest",
    "sync-android": root / "shared/sync/build/test-results/testDebugUnitTest",
    "sync-ios": root / "shared/sync/build/test-results/iosSimulatorArm64Test",
    "ui-jvm": root / "shared/ui/build/test-results/jvmTest",
    "android-app": root / "app/android/build/test-results/testDebugUnitTest",
    "desktop": root / "app/desktop/build/test-results/jvmTest",
    "server-test": root / "server/build/test-results/test",
    "server-integration": root / "server/build/test-results/integrationTest",
    "real-e2e": root / "integration-tests/build/test-results/realRemoteTest",
}

rows = []
seen_areas = set()
for line_number, raw in enumerate(manifest_path.read_text(encoding="utf-8").splitlines(), 1):
    if not raw or raw.startswith("#"):
        continue
    columns = raw.split("\t")
    if len(columns) != 4:
        raise SystemExit(
            f"invalid evidence row {line_number}: expected four tab-separated columns"
        )
    area, kind, target, selector = columns
    if area in seen_areas:
        raise SystemExit(f"duplicate evidence area at row {line_number}: {area}")
    if kind not in {"junit", "static"}:
        raise SystemExit(f"unsupported evidence kind at row {line_number}: {kind}")
    seen_areas.add(area)
    rows.append((area, kind, target, selector))

if not rows:
    raise SystemExit("evidence manifest is empty")

xml_cache = {}
def junit_cases(target):
    if target not in target_roots:
        raise SystemExit(f"unknown JUnit target: {target}")
    if target in xml_cache:
        return xml_cache[target]
    result_root = target_roots[target]
    if not result_root.is_dir():
        raise SystemExit(f"missing JUnit result root: {result_root}")
    cases = []
    for path in sorted(result_root.rglob("*.xml")):
        if path.stat().st_mtime < started - 1:
            continue
        suite = ET.parse(path).getroot()
        if int(suite.attrib.get("failures", "0")) or int(suite.attrib.get("errors", "0")):
            raise SystemExit(f"failed JUnit suite found: {path}")
        if int(suite.attrib.get("skipped", "0")):
            raise SystemExit(f"skipped JUnit suite found: {path}")
        for case in suite.iter("testcase"):
            cases.append((path, case))
    if not cases:
        raise SystemExit(f"no fresh JUnit cases for target {target}")
    xml_cache[target] = cases
    return cases

architecture_lines = set(architecture_path.read_text(encoding="utf-8").splitlines())
evidence = []
for area, kind, target, selector in rows:
    if kind == "static":
        marker = f"EVIDENCE {selector} passed"
        if target != "architecture" or marker not in architecture_lines:
            raise SystemExit(f"missing architecture evidence: {marker}")
        evidence.append({
            "area": area,
            "kind": kind,
            "target": target,
            "selector": marker,
            "result": "passed",
            "durationSeconds": 0.0,
        })
        continue

    if "#" not in selector:
        raise SystemExit(f"invalid JUnit selector for {area}: {selector}")
    class_name, method_name = selector.rsplit("#", 1)
    matches = []
    for path, case in junit_cases(target):
        case_name = case.attrib.get("name", "")
        if case.attrib.get("classname") != class_name:
            continue
        if case_name != method_name and not case_name.startswith(method_name + "["):
            continue
        matches.append((path, case))
    if len(matches) != 1:
        raise SystemExit(
            f"expected one fresh JUnit case for {area} at {target}:{selector}; "
            f"found {len(matches)}"
        )
    path, case = matches[0]
    if any(case.find(tag) is not None for tag in ("failure", "error", "skipped")):
        raise SystemExit(f"required evidence did not pass: {target}:{selector}")
    evidence.append({
        "area": area,
        "kind": kind,
        "target": target,
        "selector": selector,
        "result": "passed",
        "durationSeconds": float(case.attrib.get("time", "0") or 0),
        "resultFile": str(path.relative_to(root)),
    })

phases = []
for line in phase_path.read_text(encoding="utf-8").splitlines():
    name, duration = line.split("\t", 1)
    phases.append({
        "target": name,
        "durationSeconds": int(duration),
        "result": "passed",
    })

commit = subprocess.run(
    ["git", "rev-parse", "HEAD"],
    cwd=root,
    text=True,
    capture_output=True,
    check=True,
).stdout.strip()
dirty = bool(subprocess.run(
    ["git", "status", "--porcelain"],
    cwd=root,
    text=True,
    capture_output=True,
    check=True,
).stdout)

report = {
    "contractId": "someday-system-v2",
    "commit": commit,
    "dirtyWorktree": dirty,
    "startedAtEpochSeconds": started,
    "finishedAtEpochSeconds": finished,
    "durationSeconds": finished - started,
    "flakyRetries": 0,
    "containerImages": {
        "postgres": "postgres@sha256:16bc17c64a573ef34162af9298258d1aec548232985b33ed7b1eac33ba35c229",
        "webdav": "bytemark/webdav@sha256:bcabbc024c511b9c63ed3345f88573e31d84c952ee493c9acb3fe345f4f80f57",
    },
    "phases": phases,
    "evidence": evidence,
    "result": "passed",
}
report_path.write_text(
    json.dumps(report, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)
PY
}

require_command curl
require_command docker
require_command git
require_command java
require_java_21
require_command python3
require_command rg

cd "$ROOT_DIR"
: > "$PHASES"

phase "architecture-and-privacy" run_architecture_scan

info "starting pinned disposable services"
ensure_pinned_image "$POSTGRES_IMAGE"
ensure_pinned_image "$WEBDAV_IMAGE"

docker run -d --rm \
    --name "$POSTGRES_NAME" \
    --tmpfs /var/lib/postgresql/data:rw,noexec,nosuid,size=512m \
    -e POSTGRES_DB=someday \
    -e POSTGRES_USER=someday \
    -e POSTGRES_PASSWORD=gate-only-password \
    -p 127.0.0.1::5432 \
    "$POSTGRES_IMAGE" >/dev/null
docker run -d --rm \
    --name "$WEBDAV_NAME" \
    --tmpfs /var/lib/dav:rw,noexec,nosuid,size=256m \
    -e AUTH_TYPE=Basic \
    -e USERNAME="$WEBDAV_USERNAME" \
    -e PASSWORD="$WEBDAV_PASSWORD" \
    -e LOCATION=/ \
    -p 127.0.0.1::80 \
    "$WEBDAV_IMAGE" >/dev/null

POSTGRES_PORT="$(container_port "$POSTGRES_NAME" 5432)"
WEBDAV_PORT="$(container_port "$WEBDAV_NAME" 80)"
[[ "$POSTGRES_PORT" =~ ^[0-9]+$ ]] || die "could not resolve PostgreSQL port"
[[ "$WEBDAV_PORT" =~ ^[0-9]+$ ]] || die "could not resolve WebDAV port"
DB_URL="jdbc:postgresql://127.0.0.1:$POSTGRES_PORT/someday"
WEBDAV_ENDPOINT="http://127.0.0.1:$WEBDAV_PORT"

wait_for "PostgreSQL" docker exec "$POSTGRES_NAME" pg_isready -U someday -d someday
wait_for "WebDAV" curl -fsS -u "$WEBDAV_USERNAME:$WEBDAV_PASSWORD" -X OPTIONS "$WEBDAV_ENDPOINT/"

SERVER_PORT="$(python3 - <<'PY'
import socket
socket_value = socket.socket()
socket_value.bind(("127.0.0.1", 0))
print(socket_value.getsockname()[1])
socket_value.close()
PY
)"
SERVER_ENDPOINT="http://127.0.0.1:$SERVER_PORT"

phase "local-platform-and-protocol-tests" \
    "$GRADLEW" \
        :shared:data:verifySqlDelightMigration \
        :shared:data:jvmTest \
        :shared:domain:jvmTest \
        :shared:sync:jvmTest \
        :shared:sync:testDebugUnitTest \
        :shared:sync:iosSimulatorArm64Test \
        :shared:ui:jvmTest \
        :server:test \
        :app:desktop:jvmTest \
        :app:desktop:jvmMainClasses \
        :app:android:testDebugUnitTest \
        :app:android:compileDebugKotlin \
        :app:ios:compileKotlinIosSimulatorArm64 \
        "$GATE_PROPERTY" \
        --dependency-verification=strict \
        --stacktrace

phase "self-hosted-postgresql-integration" env \
    SOMEDAY_DB_URL="$DB_URL" \
    SOMEDAY_DB_USER=someday \
    SOMEDAY_DB_PASSWORD=gate-only-password \
    "$GRADLEW" \
        :server:integrationTest \
        :server:installDist \
        "$GATE_PROPERTY" \
        --dependency-verification=strict \
        --stacktrace

phase "self-hosted-server-startup" start_installed_server

phase "real-remote-corpus" env \
    SOMEDAY_WEBDAV_ENDPOINT="$WEBDAV_ENDPOINT" \
    SOMEDAY_WEBDAV_USERNAME="$WEBDAV_USERNAME" \
    SOMEDAY_WEBDAV_PASSWORD="$WEBDAV_PASSWORD" \
    SOMEDAY_E2E_ENDPOINT="$SERVER_ENDPOINT" \
    SOMEDAY_DB_URL="$DB_URL" \
    SOMEDAY_DB_USER=someday \
    SOMEDAY_DB_PASSWORD=gate-only-password \
    "$GRADLEW" \
        :integration-tests:realRemoteTest \
        "$GATE_PROPERTY" \
        --dependency-verification=strict \
        --stacktrace

phase "diff-hygiene" git diff --check

GATE_FINISHED_AT="$(date +%s)"
validate_and_report "$GATE_FINISHED_AT"
cp "$REPORT" "$FINAL_DIR/report.json"
info "passed; report: $FINAL_DIR/report.json"
