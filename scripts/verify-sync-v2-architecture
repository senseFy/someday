#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

fail() {
    printf 'sync-v2 architecture violation: %s\n' "$*" >&2
    exit 1
}

pass_id() {
    printf 'EVIDENCE %s passed\n' "$1"
}

CORE="shared/sync/src/commonMain/kotlin/saien/someday/sync/causality/v2"
SYNC_MAIN="shared/sync/src/commonMain"
DATA_MAIN="shared/data/src/commonMain"
UI_MAIN="shared/ui/src/commonMain"
SERVER_MAIN="server/src/main"
PLATFORM_FILES=(
    "app/android/src/main/kotlin/saien/someday/app/android/AndroidNotesRepository.kt"
    "app/desktop/src/jvmMain/kotlin/saien/someday/app/desktop/DesktopNotesRepository.kt"
    "app/ios/src/iosMain/kotlin/saien/someday/app/ios/IosNotesRepository.kt"
)
REMOTE_FILES=(
    "shared/sync/src/commonMain/kotlin/saien/someday/sync/webdav/WorkspaceWebDavSyncRemoteV2.kt"
    "shared/sync/src/commonMain/kotlin/saien/someday/sync/selfhosted/SelfHostedSyncRemoteV2.kt"
)

# Build retired labels in memory so the scanner itself does not preserve them.
retired_major_upper='V''1'
retired_major_lower='v''1'
retired_history_word='leg''acy'
retired_transition_word='cut''over'
retired_short_name='sync''[-_ ]''lite'
retired_short_title='Sync'' Lite'
retired_pattern="\\b(${retired_major_upper}|${retired_major_lower})\\b|${retired_major_upper}[A-Z_]|[A-Z_]${retired_major_upper}|${retired_history_word}|${retired_history_word^}|${retired_transition_word}|${retired_transition_word^}|${retired_short_name}|${retired_short_title}"

scan_targets=(shared app server integration-tests docs scripts README.md CONTRIBUTING.md SECURITY.md Makefile gradle.properties agent.md)
if rg -n -i \
    --glob '!**/build/**' \
    --glob '!**/.gradle/**' \
    --glob '!**/TransportTlsFailureV2Test.kt' \
    "$retired_pattern" "${scan_targets[@]}" >/dev/null; then
    rg -n -i \
        --glob '!**/build/**' \
        --glob '!**/.gradle/**' \
        --glob '!**/TransportTlsFailureV2Test.kt' \
        "$retired_pattern" "${scan_targets[@]}" >&2
    fail "retired sync surface remains in source, tests, scripts, or documentation"
fi

retired_file_pattern="(${retired_major_upper}|${retired_major_lower}|${retired_history_word}|${retired_transition_word}|${retired_short_name})"
while IFS= read -r path; do
    [[ "$path" == "server/src/main/resources/db/migration/${retired_major_upper}__server_auth_devices.sql" ]] &&
        continue
    printf '%s\n' "$path" >&2
    fail "retired sync surface remains in a file name"
done < <(rg --files shared app server integration-tests docs scripts | rg -i "$retired_file_pattern" || true)

retired_type_pattern="WebDavLogSyncClient\\b|WebDavSyncClient\\b|WebDavSyncLiteManualRunner\\b|SelfHostedManualSyncRunner\\b|EncryptedSyncObject\\b|WorkspaceObjectCipher\\b|ConflictResolutionSync\\b"
if rg -n "$retired_type_pattern" shared app server integration-tests docs >/dev/null; then
    rg -n "$retired_type_pattern" shared app server integration-tests docs >&2
    fail "retired sync implementation type remains"
fi
pass_id ARCH-NO-RETIRED

entity_values="$({
    sed -n '/enum class WorkspaceEntityTypeV2/,/^}/p' \
        "$CORE/WorkspaceEntityModelsV2.kt" |
        sed -n 's/^    [A-Z_]*("\([a-z_]*\)"),$/\1/p'
} | sort | tr '\n' ' ')"
[[ "$entity_values" == "note notebook workspace_preferences " ]] ||
    fail "the closed entity allowlist changed without schema review: $entity_values"

rg -q 'SYNC_V2_CONTRACT_ID: String = "someday-system-v2"' \
    "$CORE/WorkspaceEntityModelsV2.kt" ||
    fail "contract id changed"
rg -q 'SYNC_V2_SCHEMA_SET_VERSION: String = "workspace-entity-schema-set-v2"' \
    "$CORE/WorkspaceEntityModelsV2.kt" ||
    fail "schema-set id changed"
rg -q 'SYNC_KEY_SET_VERSION_V2: String = "sync-key-set-v2"' \
    "$CORE/SyncEpochKeyDerivationV2.kt" ||
    fail "key-set id changed"
pass_id ARCH-SCHEMA

if rg -n 'commitLocalMutations|somedayQueries|workspace_entity_versions_v2' \
    "$UI_MAIN/kotlin" app/android/src/main app/desktop/src/jvmMain app/ios/src/iosMain >/dev/null; then
    rg -n 'commitLocalMutations|somedayQueries|workspace_entity_versions_v2' \
        "$UI_MAIN/kotlin" app/android/src/main app/desktop/src/jvmMain app/ios/src/iosMain >&2
    fail "product or UI code bypasses the typed repository boundary"
fi
rg -q 'ProtocolRoutingNotesRepository' "$SYNC_MAIN/kotlin/saien/someday/sync/SyncV2ClientServices.kt" ||
    fail "production composition does not route Notes through the V2 authority"
rg -q 'SystemV2ClientSettingsRepository' "$SYNC_MAIN/kotlin/saien/someday/sync/SyncV2ClientServices.kt" ||
    fail "production composition does not route synchronized preferences through the V2 authority"
if rg -n 'listDirtySyncMetadata|listDirtyTombstones|sync_metadata|location.*dirty|dirty.*location' \
    "$CORE/WorkspaceSyncCoordinatorV2.kt" >/dev/null; then
    fail "the V2 coordinator reads projection dirty state as a transport queue"
fi
pass_id ARCH-AUTHORITY

if rg -n 'saien\.someday\.sync\.(webdav|selfhosted)' "$CORE" >/dev/null; then
    rg -n 'saien\.someday\.sync\.(webdav|selfhosted)' "$CORE" >&2
    fail "the semantic engine depends on a transport profile"
fi
if rg -n 'WorkspaceConflict(Reason|Descriptor)|FIELD_CONFLICT|CONCURRENT_DELETE_EDIT|NO_USABLE_MERGE_BASE' \
    "${REMOTE_FILES[@]}" >/dev/null; then
    fail "a transport classifies semantic conflicts"
fi
pass_id ARCH-TRANSPORT

preference_block="$(sed -n '/data class WorkspacePreferencesV2(/,/^)/p' "$CORE/WorkspaceEntityModelsV2.kt")"
for forbidden in password token endpoint username credential recovery keyMetadata notification device session backup; do
    if printf '%s\n' "$preference_block" | rg -i "$forbidden" >/dev/null; then
        fail "workspace preferences contain a local or secret field: $forbidden"
    fi
done
if rg -n 'payloadDigest' "${REMOTE_FILES[@]}" "$SERVER_MAIN" >/dev/null; then
    fail "semantic payload metadata escaped encrypted client code"
fi
pass_id ARCH-PRIVACY

service_file="$SYNC_MAIN/kotlin/saien/someday/sync/SyncV2ClientServices.kt"
rg -q 'systemV2ActivationEnabled: Boolean,' "$service_file" ||
    fail "activation input is not required"
if rg -n 'systemV2ActivationEnabled: Boolean[[:space:]]*=' "$service_file" >/dev/null; then
    fail "activation input has a silent default"
fi
for platform_file in "${PLATFORM_FILES[@]}"; do
    rg -q 'createSyncV2ClientServices\(' "$platform_file" ||
        fail "$platform_file does not use the common V2 composition"
    rg -q 'systemV2ActivationEnabled[[:space:]]*=' "$platform_file" ||
        fail "$platform_file does not wire activation explicitly"
    rg -q 'localV2KeyBoundStatePresent[[:space:]]*=' "$platform_file" ||
        fail "$platform_file does not wire the workspace replacement guard"
    rg -q 'hasKeyBoundLocalV2State\(' "$platform_file" ||
        fail "$platform_file does not inspect every key-bound lifecycle"
done
rg -q '^someday.systemV2ReleaseEnabled=false$' gradle.properties ||
    fail "release activation does not default off"
rg -q '^someday.systemV2DevelopmentEnabled=false$' gradle.properties ||
    fail "development activation does not default off"
for release_entry in scripts/package-macos-release scripts/build-ios-framework-for-xcode.sh; do
    rg -q -- '-Psomeday.systemV2ReleaseEnabled=false' "$release_entry" ||
        fail "$release_entry does not force release activation off"
    rg -q -- '-Psomeday.systemV2DevelopmentEnabled=false' "$release_entry" ||
        fail "$release_entry does not force development activation off"
done
rg -q 'CONFIGURATION=Release' scripts/release-ios.sh ||
    fail "the iOS release script does not select the controlled Release framework path"
rg -q 'scripts/build-ios-framework-for-xcode.sh' scripts/release-ios.sh ||
    fail "the iOS release script bypasses the activation-safe framework helper"
rg -q 'scripts/build-ios-framework-for-xcode.sh' iosApp/Someday.xcodeproj/project.pbxproj ||
    fail "the Xcode project bypasses the activation-safe framework helper"
rg -q 'scripts/package-macos-release' Makefile ||
    fail "the Makefile bypasses the activation-safe macOS release script"
rg -q 'scripts/build-ios-framework-for-xcode.sh' Makefile ||
    fail "the Makefile bypasses the activation-safe iOS framework helper"
pass_id ARCH-ACTIVATION

if rg -n 'deleteTree|WebDavSyncLiteReset|resetWebDavSyncLiteFolder' \
    "$SYNC_MAIN" "$UI_MAIN" app server >/dev/null; then
    rg -n 'deleteTree|WebDavSyncLiteReset|resetWebDavSyncLiteFolder' \
        "$SYNC_MAIN" "$UI_MAIN" app server >&2
    fail "a recursive WebDAV reset or tree-delete path remains"
fi
rg -q 'actionText = stringResource\(Res.string.webdav_reset_unavailable\)' \
    "$UI_MAIN/kotlin/saien/someday/ui/SomedayApp.kt" ||
    fail "the WebDAV reset row does not state that reset is unavailable"
reset_block="$(sed -n '/title = stringResource(Res.string.webdav_reset)/,/^            )/p' \
    "$UI_MAIN/kotlin/saien/someday/ui/SomedayApp.kt")"
printf '%s\n' "$reset_block" | rg -q 'enabled = false' ||
    fail "the WebDAV reset row is interactive"
pass_id ARCH-WEBDAV-RESET

join_adapter="$DATA_MAIN/kotlin/saien/someday/data/crypto/WorkspaceJoinDomainAdapters.kt"
rg -q 'localV2KeyBoundStatePresent: \(\) -> Boolean,' "$join_adapter" ||
    fail "workspace replacement guard is not a required callback"
if rg -n 'localV2KeyBoundStatePresent[^\n]*=[[:space:]]*\{[[:space:]]*false' "$join_adapter" >/dev/null; then
    fail "workspace replacement guard has a permissive default"
fi
rg -q 'if \(localV2KeyBoundStatePresent\(\)\)' "$join_adapter" ||
    fail "workspace replacement does not fail closed on key-bound state"
pass_id ARCH-PAIRING-GUARD

pairing_protocol="$SYNC_MAIN/kotlin/saien/someday/sync/pairing/WorkspacePairingProtocol.kt"
webdav_pairing="$SYNC_MAIN/kotlin/saien/someday/sync/webdav/WebDavWorkspacePairingService.kt"
webdav_paths="$SYNC_MAIN/kotlin/saien/someday/sync/webdav/WebDavPathResolver.kt"
self_hosted_pairing="$SYNC_MAIN/kotlin/saien/someday/sync/selfhosted/SelfHostedWorkspacePairingService.kt"
rg -q 'const val SECRET_BYTES: Int = 16' "$pairing_protocol" ||
    fail "pairing capability is not 128 bits"
rg -q 'const val DATA_CHARS: Int = 26' "$pairing_protocol" ||
    fail "pairing token data length changed without protocol review"
rg -q 'const val CHECKSUM_CHARS: Int = 2' "$pairing_protocol" ||
    fail "pairing token checksum length changed without protocol review"
rg -q 'const val QR_PREFIX: String = "SOMEDAY:PAIR:1:"' "$pairing_protocol" ||
    fail "pairing QR prefix changed without protocol review"
rg -Fq 'const val MAX_TTL_MILLIS: Long = 10 * 60 * 1_000L' "$pairing_protocol" ||
    fail "pairing invitation lifetime changed without protocol review"
for domain in \
    'someday.workspace-pairing.hkdf-sha256.1' \
    'someday.workspace-pairing.invite-id.1' \
    'someday.workspace-pairing.envelope-key.1' \
    'someday.workspace-pairing.state-key.1'; do
    rg -Fq "$domain" "$pairing_protocol" ||
        fail "pairing derivation domain changed without protocol review: $domain"
done
rg -Fq 'collectionPath("workspace-pairing", "1")' "$webdav_paths" ||
    fail "WebDAV pairing path is not protocol-versioned"
if rg -n 'method = "DELETE"|deletePath\(|deleteTree\(' \
    "$webdav_pairing" "$SYNC_MAIN/kotlin/saien/someday/sync/webdav/WebDavClient.kt" >/dev/null; then
    fail "WebDAV pairing has a remote delete path"
fi
for service in "$webdav_pairing" "$self_hosted_pairing"; do
    rg -q 'authorityMutationCoordinator.exclusive' "$service" ||
        fail "$service does not serialize workspace adoption against first activation"
    rg -q 'localV2KeyBoundStatePresent\(\)' "$service" ||
        fail "$service does not fail closed on key-bound local state"
done
pass_id ARCH-PAIRING-PROTOCOL

if rg -ni 'trustAll|X509TrustManager|HostnameVerifier|disableHostname|insecureSkip|ALLOW_ALL' \
    shared/sync/src app server/src/main >/dev/null; then
    fail "production transport contains a certificate or hostname bypass"
fi
rg -Fq 'require(isSecureSyncEndpoint(endpoint))' \
    "$SYNC_MAIN/kotlin/saien/someday/sync/selfhosted/KtorSelfHostedSyncTransport.kt" ||
    fail "Ktor self-hosted transport accepts an insecure endpoint"
rg -Fq 'require(isSecureSyncEndpoint(endpoint))' \
    shared/sync/src/jvmMain/kotlin/saien/someday/sync/selfhosted/JdkSelfHostedSyncTransport.kt ||
    fail "JDK self-hosted transport accepts an insecure endpoint"
rg -Fq 'require(isSecureSyncEndpoint(endpoint))' \
    "$SYNC_MAIN/kotlin/saien/someday/sync/webdav/WebDavModels.kt" ||
    fail "WebDAV configuration accepts an insecure endpoint"
pass_id ARCH-TLS

printf 'Sync V2 architecture and privacy scan passed.\n'
