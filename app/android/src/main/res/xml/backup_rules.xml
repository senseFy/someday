<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Workspace keys are bound to Android Keystore material and cannot be
      restored independently. Disable pre-Android-12 cloud backup completely
      rather than restoring an unusable database/credential half-state.
    -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
