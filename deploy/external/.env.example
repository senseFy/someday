# Copy this file to .env, restrict its permissions, and replace every empty
# required value before running `docker compose up -d` in this folder.

# Copy the tag and digest from the matching GitHub Release.
SOMEDAY_IMAGE=ghcr.io/sensefy/someday-server:X.Y.Z@sha256:<release-digest>

SOMEDAY_PUBLIC_BASE_URL=
SOMEDAY_HTTP_PORT=3180

# Use a direct/session-affine endpoint. The server verifies its certificate and
# hostname. Private CAs need sslrootcert; see the external guide.
SOMEDAY_DB_URL=
SOMEDAY_DB_USER=
SOMEDAY_DB_PASSWORD=

# Optional resource limits.
SOMEDAY_DB_MAX_POOL_SIZE=10
SOMEDAY_MEDIA_QUOTA_BYTES=5368709120

# Generate at least 32 random bytes, for example: openssl rand -base64 48
SOMEDAY_JWT_SECRET=

SOMEDAY_MEDIA_S3_BUCKET=
SOMEDAY_MEDIA_S3_REGION=
SOMEDAY_MEDIA_S3_ENDPOINT=
SOMEDAY_MEDIA_S3_PATH_STYLE=false

# Static credentials are optional when AWS container/instance credentials are available.
# Web-identity role assumption is not bundled in the current server distribution.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

SOMEDAY_REGISTRATION_ENABLED=false
SOMEDAY_TRUST_PROXY_HEADERS=false
